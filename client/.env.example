# ========================================
# PatioTime Cafe - Frontend Environment Variables
# ========================================

# API URL - Backend Server
# Development: http://localhost:5000/api
# Production: https://your-backend-url.up.railway.app/api
VITE_API_URL=http://localhost:5000/api

# ========================================
# NOTES:
# ========================================
# 1. Copy this file to .env and update values
# 2. For local development, use: http://localhost:5000/api
# 3. For production deployment, use your Railway/Render backend URL
# 4. Vite requires the VITE_ prefix for environment variables
# 5. Restart the dev server after changing .env values
