# ========================================
# PatioTime Cafe - Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ========================================
# SERVER CONFIGURATION
# ========================================

# Port for the backend server to listen on
# Default: 5000
PORT=5000

# Node environment (development, production, test)
# Default: development
NODE_ENV=development

# ========================================
# DATABASE CONFIGURATION
# ========================================

# MongoDB Connection String
# For local development: mongodb://127.0.0.1:27017/patiotime
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/patiotime
# REQUIRED - Application will not start without this
MONGO_URI=mongodb://127.0.0.1:27017/patiotime

# ========================================
# AUTHENTICATION & SECURITY
# ========================================

# JWT Secret Key for token signing
# CRITICAL: Use a strong, random string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED - Application will not start without this
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters

# JWT Token Expiration
# Examples: 1h, 24h, 7d, 30d
# Default: 7d (7 days)
JWT_EXPIRES_IN=7d

# ========================================
# CORS CONFIGURATION
# ========================================

# Frontend URL for CORS
# Development: http://localhost:3000 or http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# Additional allowed origins (comma-separated)
# Example: https://admin.example.com,https://api.example.com
# Optional
ALLOWED_ORIGINS=

# ========================================
# RATE LIMITING
# ========================================

# Enable rate limiting (true/false)
# Recommended: true for production, false for development
RATE_LIMIT_ENABLED=false

# General API rate limit (requests per window)
# Default: 100 requests per 15 minutes
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Auth endpoints rate limit (stricter)
# Default: 5 requests per 15 minutes
AUTH_RATE_LIMIT_MAX=5

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================

# Maximum file upload size in MB
# Default: 5MB
MAX_FILE_SIZE_MB=5

# Allowed image file types (comma-separated)
# Default: jpeg,jpg,png,gif,webp
ALLOWED_IMAGE_TYPES=jpeg,jpg,png,gif,webp

# Upload directory (relative to server root)
# Default: ../client/public/images
UPLOAD_DIR=../client/public/images

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# Required only if you want to send emails (order confirmations, etc.)

# SMTP Host
# Example: smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=

# SMTP Port
# Common ports: 587 (TLS), 465 (SSL), 25 (unsecured)
SMTP_PORT=587

# SMTP Authentication
SMTP_USER=
SMTP_PASSWORD=

# Email sender name and address
EMAIL_FROM_NAME=PatioTime Cafe
EMAIL_FROM_ADDRESS=noreply@patiotime.com

# ========================================
# LOGGING CONFIGURATION
# ========================================

# Log level (error, warn, info, debug)
# Default: info
LOG_LEVEL=info

# Enable request logging (true/false)
# Default: true for development, false for production
REQUEST_LOGGING=true

# ========================================
# EXTERNAL SERVICES (Optional)
# ========================================

# Cloudinary Configuration (for cloud image storage)
# Optional - only needed if using Cloudinary instead of local storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry DSN (for error tracking)
# Optional - only needed if using Sentry
SENTRY_DSN=

# Redis URL (for caching)
# Optional - only needed if using Redis
REDIS_URL=

# ========================================
# DEPLOYMENT CONFIGURATION
# ========================================

# Railway/Heroku will provide these automatically
# Don't set these locally
# RAILWAY_ENVIRONMENT=
# RAILWAY_PROJECT_ID=

# ========================================
# NOTES
# ========================================
#
# REQUIRED variables (application won't start without these):
# - MONGO_URI
# - JWT_SECRET
#
# RECOMMENDED for production:
# - Set NODE_ENV=production
# - Use strong JWT_SECRET (64+ characters)
# - Enable RATE_LIMIT_ENABLED=true
# - Set appropriate CLIENT_URL
# - Configure SMTP for email notifications
# - Setup Sentry for error tracking
#
# Security Best Practices:
# 1. Never commit .env file to git
# 2. Use different JWT_SECRET for each environment
# 3. Rotate secrets regularly
# 4. Use environment-specific MongoDB databases
# 5. Enable HTTPS in production
#
# ========================================
